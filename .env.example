# Database
DATABASE_URL="postgresql://username:password@localhost:5432/learnwise_ai?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# AI Service (OpenAI or compatible API)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# YouTube Data API v3
YOUTUBE_API_KEY="your-youtube-api-key-here"

# GitHub Personal Access Token
GITHUB_TOKEN="your-github-token-here"

# Academic Resources (Optional)
OPENALEX_EMAIL="your-email@example.com"

# Demo Mode (set to true to use mock data when APIs are unavailable)
DEMO_MODE="false"
